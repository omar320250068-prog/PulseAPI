# PostgreSQL (previous weeks)
DATABASE_URL=postgresql://taskuser:taskpassword@localhost:5432/tasksdb

# Supabase Auth (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-anon-public-key
PORT=8000

# LLM judgement (Week 5) - any OpenAI-compatible provider
# Leave LLM_API_KEY empty to fall back to the OPENAI_API_KEY env variable.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=20
LLM_MAX_RETRIES=3

# Background job alerts (A7) - optional webhook that receives retry/failure
# notifications from the job worker. Leave empty to only log to the console.
ALERT_WEBHOOK_URL=